    },
    {
      "task": "list cloudflare workers in production",
      "expectIncludes": ["mcp__cloudflare__list_workers"],
      "expectExcludes": ["mcp__gcp__query_logs", "mcp__notion__search"]
    },
    {
      "task": "check datadog latency for api gateway",
      "expectIncludes": ["mcp__datadog__query_metrics"],
      "expectExcludes": ["mcp__jira__search_issues", "mcp__filesystem__write"]
    },
    {
      "task": "read confluence runbook for incident response",
      "expectIncludes": ["mcp__atlassian__get_page"],
      "expectExcludes": ["mcp__cloudflare__list_workers", "mcp__shell__run"]
    }
  ]
